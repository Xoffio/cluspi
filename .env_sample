# Secrets only. Keep this file private (it is gitignored).
# Everything else (nodes, IPs, versions, ...) goes in cluster.yaml.
# Copy this file to .env, or run ./scripts/init_cluster.sh to create both files.

# Proxmox API token. Create it under Datacenter > Permissions > API Tokens.
PM_API_TOKEN_ID=terraform-prov@pve!terraform-token
PM_API_TOKEN_SECRET=

# Password for the external MySQL database (used with K3S datastore EDB)
DB_PASS=
